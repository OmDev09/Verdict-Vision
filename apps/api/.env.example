# Copy this to .env and fill in values

DATABASE_URL="postgresql://user:password@localhost:5432/verdict_vision"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI / RAG — Groq (cloud) + Ollama (local, for RAG development later). Priority: OLLAMA_BASE_URL else GROQ_API_KEY
# Ollama: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq: https://console.groq.com/ — llama-3.3-70b-versatile (recommended for clean answers), openai/gpt-oss-safeguard-20b, llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PINECONE_API_KEY=
PINECONE_INDEX_NAME=verdict-vision

# Storage (PDFs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=verdict-vision-judgments

# URLs (CORS, redirects)
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
