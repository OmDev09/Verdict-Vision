# ============ API (apps/api) ============
DATABASE_URL="postgresql://user:password@localhost:5432/verdict_vision"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI / RAG
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=verdict-vision
# Or: ANTHROPIC_API_KEY, MISTRAL_API_KEY

# Storage (PDFs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=verdict-vision-judgments

# Frontend URL (for CORS, redirects)
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# ============ WEB (apps/web) ============
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
